# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/photoshare
DATABASE_USERNAME=photoshare
DATABASE_PASSWORD=photoshare

# JWT (use a strong random secret in production)
JWT_SECRET=change-this-secret-in-production-min-32-chars!!

# Storage: local or s3
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (when STORAGE_TYPE=s3)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# App
PORT=8080
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
